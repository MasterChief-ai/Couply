# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Couply Auth & Session Security
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"

# Supabase PostgreSQL Connection (Optional in preview; required for Render/Supabase production)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Zero-Cost Email OTP Delivery (Configure EITHER Resend OR Gmail SMTP)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OTP_FROM_EMAIL="Couply <noreply@yourdomain.com>"
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""

# Google Sign-In OAuth Verification
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
